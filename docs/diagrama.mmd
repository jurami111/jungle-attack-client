    %% Red y validacion del protocolo
    class NetworkClient {
        -ClientPanel clientPanel
        -BlockingQueue~String~ outgoing
        -AtomicBoolean stopped
        -boolean intentionallyClosed
        -Socket socket
        -Thread readerThread
        -Thread writerThread
        +NetworkClient(ClientPanel)
        +start() void
        +close() void
    }
    class ServerMessageParser {
        -Gson gson
        +parse(String) ParseResult
    }
    class ParseResult {
        <<nested_record>>
        +message
        +error
    }

    %% Recursos y utilidades de dibujo
