    %% Herencia e implementaciones
    GameWindow --|> JFrame
    MainWindowClosingAdapter --|> WindowAdapter
    ClientPanel --|> JPanel
    MapPanel --|> JPanel
    GameController --|> MouseAdapter
    NetworkClient ..|> AutoCloseable
    SpriteCacheBufferedImageTranscoder --|> ImageTranscoder
    ClientResultsModel --|> DefaultTableModel

    %% Arranque, ventana y ciclo de conexion
    Main ..> SpriteCache : creates shared cache
    Main ..> GameWindow : creates window
    Main ..> NetworkClient : starts, closes and replaces connection
    Main ..> MainWindowClosingAdapter : closes connection on window exit
    Main ..> AtomicReference : retains replaceable connection
    Main ..> SwingUtilities : creates window on event thread
    GameWindow *-- ClientPanel : content pane
    GameWindow --> GameController : exposes panel controller
    ClientPanel ..> Runnable : leave and reconnect callback
    ClientPanel ..> Consumer : outbound message callback
    NetworkClient --> ClientPanel : delivers lines and connection state
    NetworkClient --> Socket : TCP connection
    NetworkClient ..> BlockingQueue : outgoing messages
    NetworkClient ..> AtomicBoolean : stop coordination
    NetworkClient ..> Thread : reader and writer
    NetworkClient ..> SwingUtilities : delivers callbacks on event thread
    NetworkClient ..> Consumer : panel notification callback

    %% Vista, controlador y modelo
    ClientPanel *-- GameState : observed UI state
    ClientPanel *-- ServerMessageParser : validates inbound JSON
    ClientPanel *-- MapPanel : displays selected screen
    ClientPanel *-- GameController : routes game interactions
    ClientPanel *-- ClientResultsModel : read-only results table model
    ClientPanel o-- "0..*" JPanel : screen cards and layout containers
    ClientPanel o-- "0..*" JButton : create, join, choose, leave and return
    ClientPanel o-- "0..*" JLabel : status, statistics and headings
    ClientPanel o-- "0..*" JTextField : nickname and match code
    ClientPanel o-- JComboBox : species selection
    ClientPanel ..> JTable : displays result rows
    ClientPanel ..> DTO_Snapshot : renders current snapshot
    ClientPanel ..> ClickableAnimal : projects animals for hit testing
    ClientPanel ..> Gson : serializes client requests
    ClientPanel ..> ModelObserver : registers state refresh callback
    GameState o-- "0..*" ModelObserver : notifies observers
    ModelObserver ..> GameState : callback parameter
    GameState --> GameStatePhase : current phase
    GameState --> DTO_AnimalSelection : selection state
    GameState --> DTO_Snapshot : current match state
    GameState --> DTO_GameOver : result state
    GameState ..> ServerMessage : applies inbound message
    GameController --> MapPanel : reads clicks and updates selection
    GameController ..> MouseEvent : interprets player clicks
    GameController o-- "0..*" ClickableAnimal : own and visible projections
    GameController ..> MapZones : resolves occupied map zones
    GameController ..> GameControllerCommand : serializes outbound command
    GameControllerCommand *-- GameControllerMovePayload
    GameControllerCommand *-- GameControllerAttackPayload
    GameControllerCommand *-- GameControllerZonePayload
    GameController ..> Consumer : sends serialized JSON
    GameController ..> Gson : serializes command envelopes

    %% Protocol payload hierarchy and containment
    ServerMessage *-- ServerMessagePayload : payload field
    ServerMessageParser --> ParseResult : returns parse result
    ServerMessageParser ..> Gson : strict JSON parsing
    ParseResult --> ServerMessage : optional parsed message
    ServerMessagePayload <|.. DTO_MatchCode
    ServerMessagePayload <|.. DTO_PlayerJoined
    ServerMessagePayload <|.. DTO_AnimalSelection
    ServerMessagePayload <|.. DTO_Snapshot
    ServerMessagePayload <|.. DTO_GameOver
    ServerMessagePayload <|.. DTO_MatchCancelled
    ServerMessagePayload <|.. DTO_ServerError
    DTO_Snapshot *-- DTO_Pack : ownPack
    DTO_Snapshot *-- "0..*" DTO_Animal : own and visible animals
    DTO_Snapshot *-- "0..*" DTO_Zone : visibleZones
    DTO_Snapshot *-- "0..*" DTO_CoffeeCup : visibleCoffeeCups
    DTO_Snapshot *-- "0..*" DTO_Flag : visibleFlags
    DTO_Animal --> DTO_Attack : optional attack animation
    DTO_GameOver *-- "0..*" DTO_PackSummary

    %% Representacion del mapa y geometria demostrativa
    MapPanel --> SpriteCache : image and animation lookup
    MapPanel --> DTO_Snapshot : renders server state
    MapPanel o-- "0..*" ClickableAnimal : selection overlay
    MapPanel *-- Animator : demonstration animation
    MapPanel ..> FogOfWar : paints hidden map regions
    MapPanel ..> EnergyBar : paints animal energy
    MapPanel ..> UIConstants : zoom, dimensions and colors
    MapPanel o-- "0..*" MapPanelRoute : demonstration routes
    MapPanel o-- "0..*" MapPanelZoneArea : demonstration zones
    MapPanel o-- "0..*" JComboBox : route, direction and zone selectors
    MapPanel o-- JButton : demonstration movement control
    MapPanelRoute *-- Connection
    MapPanelRoute *-- Path2D : cached route drawing
    MapPanelZoneArea *-- Rectangle2D : demonstration bounds
    MapPanel ..> Timer : repaint and demo animation timers
    MapPanel ..> Graphics2D : paints map and entities
    MapPanel ..> AffineTransform : applies zoom and camera translation
    MapPanel ..> Ellipse2D : draws animal selection rings
    MapPanel ..> BufferedImage : map and sprite frames
    MapPanel ..> Area : visible game region
    MapPanel ..> Point : screen click conversion
    SpriteAnimation --> BufferedImage : idle image and frames
    AnimatorState --> BufferedImage : current frame
    SpriteCache ..> BufferedImage : cached rasterized assets
    MapPanel ..> MapPanelMapDefinition : parses connections resource
    MapPanel ..> MapPanelZoneMapDefinition : parses zone resource
    MapPanelMapDefinition *-- "0..*" MapPanelPathDefinition
    MapPanelPathDefinition *-- "2..*" MapPanelPathPoint
    MapPanelPathDefinition ..> Connection : converted from route JSON
    MapPanelZoneMapDefinition *-- "0..*" MapPanelZoneDefinition
    MapPanelZoneDefinition ..> MapPanelZoneArea : validated zone bounds
    Animator ..> AnimatorState : emits update callback value
    Animator ..> Consumer : update callback
    Animator ..> Connection : demonstration route input
    Animator ..> Point2D : movement path coordinates
    Animator --> SpriteAnimation : animated frames
    Animator --> Timer : animation clock
    Animator ..> UIConstants : timer interval
    MapZones ..> DTO_Zone : server zone centers
    MapZones ..> Rectangle2D : builds Voronoi clipping area
    MapZones ..> Path2D : clips map geometry
    MapZones ..> Area : calculates visible region
    Connection ..> Point2D : route coordinates
    Zone ..> Point2D : legacy position field

    %% Carga de sprites, animaciones y utilidades
    SpriteCache *-- "0..*" SpriteAnimation : cached animations
    SpriteCache ..> SpriteCacheAnimationManifest : parses manifest
    SpriteCacheAnimationManifest *-- "0..*" SpriteCacheAnimalDefinition
    SpriteCacheAnimalDefinition *-- "0..*" SpriteCacheFrameDefinition
    SpriteCache ..> SpriteCacheSvgLoadResult : records SVG load outcome
    SpriteCache ..> SpriteCacheBufferedImageTranscoder : rasterizes SVG
    SpriteCache ..> Gson : parses animation manifest
    SpriteCacheAnimalDefinition ..> SpriteAnimation : builds animation
    SpriteCacheSvgLoadResult ..> BufferedImage : optional loaded image
    EnergyBar ..> Graphics2D : draws energy bars
    EnergyBar ..> UIConstants : reads colors and dimensions
    FogOfWar ..> Graphics2D : draws fog overlay
    FogOfWar ..> Area : clips visible and hidden regions
    FogOfWar ..> RoundRectangle2D : draws fog edge
    FogOfWar ..> UIConstants : reads fog appearance
    UIConstants ..> Color : stores presentation colors
    MapPanel ..> MapZones : game visibility geometry
    ClientPanel ..> MapZones : validates supported zone centers
    ClientPanel ..> AnimalSpecies : validates server species

    %% Zone es un record legado que no participa en el flujo actual de produccion.
    note for Zone "Record de modelo legado; el flujo activo usa MapZones y ServerMessage.Zone."
    %% MessageSender.java esta vacio y no declara un tipo Java que pueda diagramarse.
    note for NetworkClient "MessageSender.java esta vacio y no declara ningun tipo Java."
    note for ServerMessage "DTO_ identifica records anidados; otros prefijos documentan nombres nested. MainWindowClosingAdapter y ClientResultsModel son aliases descriptivos de clases anonimas."
    note for Main "Incluye todos los tipos declarados en src/main/java, incluidos los nested y auxiliares privados. Las clases de prueba y tipos rutinarios de colecciones no se listan."
