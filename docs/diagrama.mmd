        +TEST_ANIMAL_SIZE$
        +TEST_MOVEMENT_SPEED$
        +MAX_PLAYER_ENERGY$
        +MAX_BOT_ENERGY$
        +ENERGY_BAR_WIDTH$
        +ENERGY_BAR_HEIGHT$
        +ENERGY_BAR_GAP$
        +ENERGY_BAR_BORDER_COLOR$
