        +id
        +name
        +position
    }
    class Connection {
        <<record>>
        +fromZoneId
        +toZoneId
        +pathPoints
        +hiddenSegments
        +reversed() Connection
        +followedBy(Connection) Optional
    }
    class MapZones {
        <<utility>>
        +ALL$
        +at(double, double)$ Optional
        +visibleArea(String, double, double)$ Area
    }

