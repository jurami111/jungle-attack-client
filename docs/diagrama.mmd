    class GameWindow {
        -GameController controller
        -ClientPanel clientPanel
        +GameWindow(SpriteCache)
        +getController() GameController
        +getClientPanel() ClientPanel
    }
    class MainWindowClosingAdapter {
        <<anonymous_class>>
    }

    %% Vista Swing
    class ClientPanel {
        -GameState model
        -ServerMessageParser parser
        -Gson gson
        -MapPanel map
        -GameController controller
        -Consumer~String~ sender
        -Runnable leaveHandler
        -boolean requestPending
        -Snapshot renderedSnapshot
        +ClientPanel(SpriteCache)
        +getController() GameController
        +getModel() GameState
        +setLeaveHandler(Runnable) void
        +setMessageSender(Consumer) void
        +receiveServerLine(String) void
        +connectionClosed(String) void
        +reportConnectionError(String) void
    }
    class ClientResultsModel {
        <<anonymous_class>>
    }
    class MapPanel {
        -SpriteCache spriteCache
        -Snapshot snapshot
        -boolean demonstration
        -Animator animator
        -List~Route~ routes
        -List~Route~ reversedRoutes
        -List~ZoneArea~ zones
        -Area visibleGameArea
        -double zoom
        -double cameraOffsetX
        -double cameraOffsetY
        +MapPanel(SpriteCache)
        +MapPanel(SpriteCache, boolean)
        +showSnapshot(Snapshot) void
        +clearGame() void
        +stopGameAnimation() void
        +setZoneRequestHandler(Consumer) void
        +hasZone(String) boolean
        +showGameZones(List, String) void
        +isVisiblePoint(double, double) boolean
        +toMapPoint(Point) Optional
        +showSelection(List) void
        +showInteractionStatus(String) void
    }
    class MapPanelRoute {
        <<private_record>>
        +label
        +connection
        +path
    }
    class MapPanelZoneArea {
        <<private_record>>
        +id
        +name
        +bounds
    }
    class MapPanelZoneMapDefinition {
        <<private_record>>
        +zones
    }
    class MapPanelZoneDefinition {
        <<private_record>>
        +id
        +name
        +x
        +y
        +width
        +height
    }
    class MapPanelMapDefinition {
        <<private_record>>
        +connections
    }
    class MapPanelPathDefinition {
        <<private_record>>
        +label
        +fromZoneId
        +toZoneId
        +points
        +hiddenSegments
    }
    class MapPanelPathPoint {
        <<private_record>>
        +x
        +y
    }

    %% Controladores
    class GameController {
        -MapPanel view
        -Gson gson
        -Set~Integer~ selectedIds
        -List~ClickableAnimal~ ownAnimals
        -List~ClickableAnimal~ visibleAnimals
        -List~String~ visibleZones
        -String selectedZone
        -Set~Integer~ exploringIds
        -Set~String~ followedZones
        -String requestedFollowZone
        -Consumer~String~ messageSender
        +GameController(MapPanel)
        +setMessageSender(Consumer) void
        +setInteractionEnabled(boolean) void
        +updateState(List, List, List, String) void
        +mouseClicked(MouseEvent) void
        +onAutomaticZoneRequestRejected() void
    }
    class GameControllerCommand {
        <<private_generic_record>>
        +type
        +payload
    }
    class GameControllerMovePayload {
        <<private_record>>
        +animalIds
        +targetX
        +targetY
    }
    class GameControllerAttackPayload {
        <<private_record>>
        +animalIds
        +targetId
    }
    class GameControllerZonePayload {
        <<private_record>>
        +zone
    }
    class Animator {
        +DOWN$
        -Timer timer
        -Consumer~State~ onUpdate
        -LongSupplier clock
        -List~Point2D~ path
        -SpriteAnimation animation
        +Animator(Consumer)
        +start(Point2D, Point2D, SpriteAnimation, int) boolean
        +start(List, SpriteAnimation, int) boolean
        +startAtSpeed(List, SpriteAnimation, double) boolean
        +startAtSpeed(Connection, SpriteAnimation, double) boolean
        +stop() void
    }
    class AnimatorState {
        <<record>>
        +x
        +y
        +image
        +moving
        +visible
        +heading
    }

    %% Modelo de interfaz y mapa
    class GameState {
        -List~ModelObserver~ observers
        -Phase phase
        -String code
        -String opponent
        -AnimalSelection selection
        -Snapshot snapshot
        -GameOver result
        +addObserver(ModelObserver) void
        +connected() void
        +disconnected(String) void
        +report(String) void
        +returnHome() void
        +apply(ServerMessage) void
    }
    class GameStatePhase {
        <<nested_enum>>
        DISCONNECTED
        HOME
        WAITING
        SELECTING
        PLAYING
        FINISHED
    }
    class ModelObserver {
        <<functional_interface>>
        +onStateChanged(GameState) void
    }
    class AnimalSpecies {
        <<enum>>
        MONO
        MARIPOSA
        RANA
        PEREZOSO
        SERPIENTE
        TORTUGA
        YIGUIRRO
        +spriteName() String
        +find(String)$ Optional
    }
